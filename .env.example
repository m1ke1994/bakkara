# Bakkara uses ports distinct from new_bot (8000 / 5173).
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8010
FRONTEND_ORIGIN=http://127.0.0.1:5174
VITE_API_BASE_URL=http://127.0.0.1:8010

TARGET_URL=https://1xlite-12669.pro/ru/live/baccarat/2050671-baccara
AUTH_POLL_SECONDS=2

AUTH_CURRENCY_SELECTOR=.double-row-header-balance-info__currency
AUTH_CURRENCY_TEXT=RUB
AUTH_CURRENCY_SELECTOR_FALLBACKS=.double-row-header-balance-info__content||.double-row-header-balance__info||.balance__currency

# Read-only game observation. No credentials or betting settings are used.
GAME_LIST_URL=https://1xlite-12669.pro/ru/live/baccarat/2050671-baccara
OBSERVATION_POLL_SECONDS=1
# DOM card snapshots are read 6–10 times per second while a game is open.
CARD_POLL_SECONDS=0.15
# The live Baccarat page exposes both sides using the same wrapper class.
# Match the visible name so card scanning stays scoped to Player, not Banker.
PLAYER_NAME_TEXT=Игрок
# The optional list status is read only from explicit DOM text; otherwise it is
# saved as "Не удалось определить". Rows are scanned in their current DOM order.
BANKER_NAME_TEXT=Банкир
# Retained for compatibility; the card observer no longer adds this fixed wait.
GAME_PAGE_WAIT_SECONDS=5
# Emit a diagnostic at this interval; it never finalizes a hand or advances.
PLAYER_HAND_TIMEOUT_SECONDS=90
# Upper bound for diagnostic cadence while a game remains under observation.
GAME_FINISH_TIMEOUT_SECONDS=180
# Retry a game after a technical navigation/read failure.
INCOMPLETE_RETRY_SECONDS=30
# This selector is always text-checked against exact "Игра завершена". A
# market-grid end panel is also accepted only when its visible text matches.
ROUND_FINISHED_SELECTOR=.ui-caption--size-xl.ui-caption--weight-700
# Optional active-game marker; leave unset until one is verified on the live DOM.
# GAME_ACTIVE_SELECTOR=.verified-active-game
